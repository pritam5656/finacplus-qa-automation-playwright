{
  "name": "qa-automation-case-study",
  "version": "1.1.0",
  "description": "Playwright JS UI + API tests for DemoQA and ReqRes",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui --headed",
    "test:debug": "playwright test --project=ui --debug",
    "report": "playwright show-report",
    "trace": "playwright show-trace",
    "artifacts": "node scripts/export-artifacts.js",
    "test:submit": "npm test && npm run artifacts"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "dotenv": "^16.4.7"
  }
}
